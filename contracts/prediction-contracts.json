              "enum": ["actionable", "health_management", "contextual"]
            },
            "contributing_features": {
              "type": "array",
              "items": {"type": "string"}
            },
            "changes": {
              "type": "array",
              "items": {
                "type": "object",
                "additional_properties": false,
                "required": ["field", "from_value", "to_value", "unit"],
                "properties": {
                  "field": {"type": "string"},
                  "from_value": {},
                  "to_value": {},
                  "unit": {"type": ["string", "null"]}
                }
              }
            },
            "message": {"type": "string"},
            "new_probability": {"type": "number", "minimum": 0, "maximum": 1},
            "reduction_percentage_points": {"type": "number", "exclusiveMinimum": 0},
            "relative_reduction_percent": {"type": "number", "exclusiveMinimum": 0},
