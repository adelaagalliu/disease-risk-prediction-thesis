{
  "contract_version": "1.1.0",
  "classification_rule": "elevated when probability >= threshold; otherwise not_elevated",
  "common_rules": {
    "unknown_fields": "reject",
    "null_behavior": "reject unless the input explicitly allows null",
    "boolean_encoding": {
      "false": 0,
      "true": 1
    },
    "sex_encoding": {
      "female": 0,
      "male": 1
    },
    "age_range_derivation": {
      "source_input": "age",
      "ranges": [
        {
          "minimum": 18,
          "maximum_exclusive": 25,
          "value": 1
        },
        {
          "minimum": 25,
          "maximum_exclusive": 30,
          "value": 2
        },
        {
          "minimum": 30,
          "maximum_exclusive": 35,
          "value": 3
        },
        {
          "minimum": 35,
          "maximum_exclusive": 40,
          "value": 4
        },
        {
          "minimum": 40,
          "maximum_exclusive": 45,
          "value": 5
        },
        {
          "minimum": 45,
          "maximum_exclusive": 50,
          "value": 6
        },
        {
          "minimum": 50,
          "maximum_exclusive": 55,
          "value": 7
        },
        {
          "minimum": 55,
          "maximum_exclusive": 60,
          "value": 8
        },
        {
          "minimum": 60,
          "maximum_exclusive": 65,
          "value": 9
        },
        {
          "minimum": 65,
          "maximum_exclusive": 70,
          "value": 10
        },
        {
          "minimum": 70,
          "maximum_exclusive": 75,
          "value": 11
        },
        {
          "minimum": 75,
          "maximum_exclusive": 80,
          "value": 12
        },
        {
          "minimum": 80,
          "maximum_inclusive": 120,
          "value": 13
        }
      ]
    },
    "bmi_derivation": {
      "formula": "weight_kg / ((height_cm / 100) ** 2)",
      "round_to_decimal_places": 2,
      "minimum": 10,
      "maximum": 80,
      "out_of_range_behavior": "reject"
    },
    "training_and_preprocessing": {
      "random_state": 44,
      "outer_split": {
        "method": "StratifiedGroupKFold",
        "folds": 10,
        "allocation": {
          "train_folds": 7,
          "validation_folds": 1,
          "test_folds": 2
        },
        "approximate_proportions": {
          "train": 0.7,
          "validation": 0.1,
          "test": 0.2
        },
        "grouping": "Stable hash of the complete raw predictor profile before imputation and feature engineering",
        "group_column": "_group_id",
        "group_column_is_predictor": false,
        "reason": "Prevents identical predictor profiles from crossing train, validation, and test boundaries"
      },
      "missing_values": {
        "fit_scope": "training split only",
        "subgroup_minimum_n": 30,
        "unseen_or_sparse_group_fallback": "overall training statistic",
        "training_smoker_mask": {
          "datasets": [
            "diabetes",
            "heart_disease",
            "hypertension"
          ],
          "fraction_of_known_training_values": 0.05,
          "validation_or_test_masked": false,
          "fill": "training observed smoker rate",
          "indicator": "smoker_was_missing"
        },
        "hypertension": {
          "bmi": "training median",
          "heart_rate": "training median",
          "cholesterol": "training age_range conditional median; overall training median fallback",
          "bp_meds": "training binary mode within systolic BP bands [0,120), [120,140), [140,160), [160,180), [180,1000); overall training mode fallback",
          "bp_meds_indicator": "bp_meds_was_missing",
          "cigs_per_day": "training median among smokers; 0 for non-smokers",
          "glucose": "training diabetes-subgroup median; overall training median fallback",
          "post_imputation_recalculation": "high_chol = 1 when cholesterol > 200"
        },
        "stroke": {
          "sex_binary": "drop the one unencodable gender='Other' row before splitting",
          "bmi": "training age_range conditional median; overall training median fallback",
          "bmi_indicator": "bmi_was_missing",
          "smoking_status": "retain current, former, and unknown indicators; never smoked is reference"
        },
        "deployment_distinction": "The historical training data are imputed as documented, but API requests reject missing required user inputs. Complete prediction requests set applicable missingness indicators to 0."
      },
      "feature_engineering_order": "after splitting and after train-fitted imputation",
      "model_search": {
        "candidates": [
          "logreg",
          "random_forest",
          "xgboost",
          "lightgbm",
          "catboost"
        ],
        "method": "RandomizedSearchCV",
        "iterations_per_model": 10,
        "cross_validation": "3-fold StratifiedGroupKFold on training data",
        "selection_metric": "average_precision",
        "primary_model_selection_source": "grouped training cross-validation only",
        "class_imbalance": "model-specific class weighting; no synthetic oversampling",
        "threshold_selection": "maximize F1 on validation over thresholds 0.01 to 0.99 in 0.01 steps",
        "test_usage": "held out for final evaluation; not used for model or threshold selection"
      },
      "scaling": {
        "logreg": "StandardScaler for continuous and ordinal columns, fit inside the training pipeline",
        "tree_models": "passthrough; no scaling"
      },
      "evaluation": {
        "threshold_dependent": [
          "accuracy",
          "precision",
          "recall",
          "f1",
          "confusion_matrix"
        ],
        "threshold_independent": [
          "roc_auc",
          "average_precision"
        ],
        "uncertainty": "95% percentile confidence intervals from 1000 group-bootstrap resamples",
        "calibration": "Brier score and 10-bin quantile reliability curve"
      },
      "explainability": {
        "method": "SHAP",
        "background_rows_from_training": 100,
        "explained_rows_from_test": 200,
        "local_examples_per_model": 3,
        "interpretation": "within-model feature contribution, not causal effect"
      }
    }
  },
