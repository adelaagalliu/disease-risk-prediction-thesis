        "type": "string",
        "enum": [
          "catboost",
          "lightgbm",
          "logreg"
        ]
      },
      "model_version": {
        "type": "string"
      },
      "probability": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "classification": {
        "type": "string",
        "enum": [
          "elevated",
          "not_elevated"
        ]
      },
      "threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "top_factors": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "additional_properties": false,
          "required": [
            "feature",
            "label",
            "value",
            "direction",
            "importance",
            "modifiable"
          ],
          "properties": {
            "feature": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "value": {
              "description": "A user-facing rendering of the request value or source values; encoded interaction products are not exposed"
            },
            "direction": {
              "type": "string",
              "enum": [
                "increases_estimate",
                "decreases_estimate"
              ]
            },
            "importance": {
              "type": "number",
              "minimum": 0
            },
            "modifiable": {
              "type": "boolean"
            }
          }
        }
      },
      "recommendations": {
        "type": "array",
        "maxItems": 5,
        "description": "The highest-impact applicable counterfactuals drawn from the ten largest SHAP contributors. Scenarios that do not lower the model estimate by at least 0.5 percentage points are omitted.",
        "items": {
          "type": "object",
          "additional_properties": false,
          "required": [
            "action",
            "scenario_type",
            "contributing_features",
            "changes",
            "message",
            "new_probability",
            "reduction_percentage_points",
