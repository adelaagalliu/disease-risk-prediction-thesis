    "properties": {
      "contract_version": {
        "type": "string",
        "const": "1.1.0"
      },
      "prediction_id": {
        "type": "string",
        "format": "uuid",
        "required_after_persistence_is_implemented": true
      },
      "disease": {
        "type": "string",
        "enum": [
          "diabetes",
          "heart_disease",
          "hypertension",
          "stroke"
        ]
      },
