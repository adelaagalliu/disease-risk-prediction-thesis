        "glucose": {
          "required": true,
          "type": "number",
          "minimum": 30,
          "maximum": 700,
          "unit": "mg/dL"
        }
      },
      "transformations": {
        "smoker": "1 when smoking_status is current; otherwise 0",
        "cigs_per_day": "copy from cigarettes_per_day",
        "high_bp": "1 when systolic_bp >= 130 or diastolic_bp >= 80; otherwise 0",
        "high_chol": "1 when cholesterol > 200; otherwise 0",
        "bp_meds_was_missing": 0
      },
